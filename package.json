{
  "name": "bundle-grep-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "oxlint",
    "docs:check": "tsx scripts/doccheck.ts",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "cli": "tsx packages/cli/src/main.ts",
    "build": "pnpm build:web && pnpm --filter bundle-grep build",
    "dev:web": "pnpm --filter @bundle-grep/web dev",
    "build:web": "pnpm --filter @bundle-grep/web build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "srvx": "1.0.6",
    "tsdown": "0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
