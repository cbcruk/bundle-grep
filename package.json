{
  "name": "bundle-grep-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/desktop/www",
    "lint": "oxlint",
    "docs:check": "bun scripts/doccheck.ts",
    "test": "bun test",
    "dev:ui": "pnpm --filter @bundle-grep/desktop dev",
    "build:ui": "pnpm --filter @bundle-grep/desktop build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  }
}
